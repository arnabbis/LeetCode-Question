let nums = [-2,0,1,1,2];
let sortedArr = nums.sort((a,b)=>a-b);
let arr = [];

for(let i=0;i<sortedArr.length-2;i++){
    let left = i+1;
    let right = sortedArr.length-1;
    while(left<right){
        let sum = sortedArr[i] + sortedArr[left] + sortedArr[right];
        if(sum===0){
            arr.push([sortedArr[i],sortedArr[left],sortedArr[right]])
             left++;
            right--;
        }else if(sum<0){
            left++;
        }else{
            right--;
        }
    }
}
console.log(arr)